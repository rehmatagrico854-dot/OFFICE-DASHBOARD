<?xml version='1.0' encoding='utf-8'?>
<widget id="com.rehmat.myoffice"
        version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:android="http://schemas.android.com/apk/res/android">

    <name>My Office</name>

    <description>
        Personal Offline Office Management App
    </description>

    <author email="rehmat@example.com">
        Rehmat
    </author>

    <content src="index.html" />

    <access origin="*" />

    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="mailto:*" />

    <!-- =================================================
         ANDROID
         ================================================= -->

    <preference
        name="android-minSdkVersion"
        value="24" />

    <preference
        name="android-targetSdkVersion"
        value="35" />

    <preference
        name="android-compileSdkVersion"
        value="35" />

    <preference
        name="AndroidXEnabled"
        value="true" />

    <preference
        name="GradlePluginKotlinEnabled"
        value="true" />

    <preference
        name="SplashScreenDelay"
        value="0" />

    <preference
        name="AutoHideSplashScreen"
        value="true" />

    <!-- =================================================
         CAMERA
         ================================================= -->

    <plugin
        name="cordova-plugin-camera"
        spec="^8.0.0" />

    <!-- =================================================
         FILE SELECTOR
         ================================================= -->

    <plugin
        name="cordova-plugin-file"
        spec="^8.1.0" />

    <plugin
        name="cordova-plugin-filechooser"
        spec="^1.0.0" />

    <!-- =================================================
         LOCAL NOTIFICATIONS
         ================================================= -->

    <plugin
        name="cordova-plugin-local-notification"
        spec="^0.9.0" />

    <!-- =================================================
         STATUS BAR
         ================================================= -->

    <preference
        name="StatusBarStyle"
        value="lightcontent" />

    <preference
        name="StatusBarBackgroundColor"
        value="#10182D" />

    <!-- =================================================
         ANDROID APP LABEL
         ================================================= -->

    <edit-config
        file="app/src/main/AndroidManifest.xml"
        mode="merge"
        target="/manifest/application">

        <application
            android:usesCleartextTraffic="true" />

    </edit-config>

</widget>
