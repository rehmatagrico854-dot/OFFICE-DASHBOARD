<?xml version="1.0" encoding="UTF-8"?>

<widget
    id="com.myoffice.app"
    version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>My Office</name>

    <description>
        A beautiful offline office management application.
    </description>

    <author email="support@myoffice.app">
        My Office
    </author>


    <!-- =================================================
         START PAGE
    ================================================== -->

    <content src="index.html" />


    <!-- =================================================
         ACCESS
    ================================================== -->

    <access origin="*" />


    <!-- =================================================
         ANDROID
    ================================================== -->

    <preference
        name="AndroidXEnabled"
        value="true" />

    <preference
        name="android-minSdkVersion"
        value="24" />

    <preference
        name="android-targetSdkVersion"
        value="35" />

    <preference
        name="android-compileSdkVersion"
        value="35" />


    <!-- =================================================
         DISPLAY
    ================================================== -->

    <preference
        name="Fullscreen"
        value="false" />

    <preference
        name="Orientation"
        value="portrait" />

    <preference
        name="DisallowOverscroll"
        value="true" />

    <preference
        name="SplashScreenDelay"
        value="0" />


    <!-- =================================================
         STATUS BAR
    ================================================== -->

    <preference
        name="StatusBarBackgroundColor"
        value="#10182D" />

    <preference
        name="StatusBarStyle"
        value="lightcontent" />


    <!-- =================================================
         CAMERA
    ================================================== -->

    <plugin
        name="cordova-plugin-camera"
        spec="7.0.0" />


    <!-- =================================================
         FILE STORAGE
    ================================================== -->

    <plugin
        name="cordova-plugin-file"
        spec="8.1.3" />


    <!-- =================================================
         FILE PICKER
    ================================================== -->

    <plugin
        name="cordova-plugin-filechooser"
        spec="1.2.0" />


    <!-- =================================================
         LOCAL NOTIFICATIONS
    ================================================== -->

    <plugin
        name="cordova-plugin-local-notification"
        spec="1.2.3" />


    <!-- =================================================
         ANDROID NOTIFICATION / ALARM PERMISSIONS
    ================================================== -->

    <config-file
        target="AndroidManifest.xml"
        parent="/manifest">

        <uses-permission
            android:name="android.permission.POST_NOTIFICATIONS" />

        <uses-permission
            android:name="android.permission.SCHEDULE_EXACT_ALARM"
            android:maxSdkVersion="32" />

        <uses-permission
            android:name="android.permission.USE_EXACT_ALARM" />

    </config-file>


    <!-- =================================================
         CAMERA PERMISSION
    ================================================== -->

    <edit-config
        file="app/src/main/AndroidManifest.xml"
        mode="merge"
        target="/manifest/uses-permission">

    </edit-config>


</widget>
